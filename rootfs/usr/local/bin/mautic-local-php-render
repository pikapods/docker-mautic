#!/usr/bin/env php
<?php
// mautic-local-php-render: merge env into /data/config/local.php.
//
// Strategy: load all existing keys (preserves anything mautic:install,
// the web installer, or the admin UI wrote), then overwrite the
// operator-managed slots from env, and apply MAUTIC_PARAM_<KEY>
// passthrough on top. Anything the user has set elsewhere survives.
//
// Operator-managed (always overwritten from env): db_driver, db_host,
// db_port, db_name, db_user, db_password, db_table_prefix, site_url.
// secret_key is generated once on first boot and preserved thereafter
// (rotating it invalidates encrypted DB columns and active sessions).
// MAUTIC_PARAM_<KEY> env vars pass through as <key> => <value> after
// lower-snake conversion; sentinel values `unset`, `null`, or empty
// string delete the key.

if (PHP_SAPI !== 'cli') { fwrite(STDERR, "cli only\n"); exit(2); }

$target = $argv[1] ?? '';
if ($target === '') {
    fwrite(STDERR, "usage: mautic-local-php-render <path-to-local.php>\n");
    exit(2);
}

// Load existing file (if any) so every key it defined survives unless
// we explicitly overwrite or delete it below.
$out = [];
if (is_file($target)) {
    $parameters = [];
    // Mautic's local.php only ever defines $parameters; include is safe.
    include $target;
    if (is_array($parameters ?? null)) {
        $out = $parameters;
    }
}

// Ops-managed keys — always overwrite from env.
$out['db_driver']       = 'pdo_mysql';
$out['db_host']         = (string) getenv('MAUTIC_DB_HOST');
$out['db_port']         = (string) (getenv('MAUTIC_DB_PORT') ?: '3306');
$out['db_name']         = (string) getenv('MAUTIC_DB_DATABASE');
$out['db_user']         = (string) getenv('MAUTIC_DB_USER');
$out['db_password']     = (string) getenv('MAUTIC_DB_PASSWORD');
$out['db_table_prefix'] = (string) getenv('MAUTIC_DB_TABLE_PREFIX');
$out['site_url']        = rtrim((string) getenv('MAUTIC_URL'), '/');

// secret_key: generate on first boot only.
if (empty($out['secret_key'])) {
    $out['secret_key'] = bin2hex(random_bytes(32));
}

// MAUTIC_PARAM_<KEY> passthrough. Empty / unset / null deletes.
foreach ($_ENV + getenv() as $name => $value) {
    if (!is_string($name) || strncmp($name, 'MAUTIC_PARAM_', 13) !== 0) {
        continue;
    }
    $raw = substr($name, 13);
    if ($raw === '' || !preg_match('/^[A-Z0-9_]+$/', $raw)) {
        fwrite(STDERR, "[mautic-local-php-render] skip invalid env key: '$name'\n");
        continue;
    }
    $key = strtolower($raw);
    $val = (string) $value;

    if ($val === '' || strcasecmp($val, 'unset') === 0 || strcasecmp($val, 'null') === 0) {
        unset($out[$key]);
        continue;
    }
    $out[$key] = coerceScalar($val);
}

// Render as a valid PHP file.
$lines = ["<?php", "// Generated by mautic-local-php-render. Edits will be overwritten on next boot.", "\$parameters = ["];
foreach ($out as $k => $v) {
    $lines[] = sprintf("    %s => %s,", var_export((string) $k, true), exportValue($v));
}
$lines[] = "];";
$lines[] = "";

$tmp = $target . '.tmp';
if (file_put_contents($tmp, implode("\n", $lines)) === false) {
    fwrite(STDERR, "[mautic-local-php-render] failed to write $tmp\n");
    exit(1);
}
if (!rename($tmp, $target)) {
    fwrite(STDERR, "[mautic-local-php-render] failed to rename $tmp -> $target\n");
    exit(1);
}
exit(0);

function coerceScalar(string $v) {
    // Type-coerce common literals so MAUTIC_PARAM_DB_PORT=3306 lands as int
    // and MAUTIC_PARAM_MAILER_ENCRYPTION_TLS=true lands as bool.
    $lc = strtolower($v);
    if ($lc === 'true')  return true;
    if ($lc === 'false') return false;
    if (preg_match('/^-?\d+$/', $v))      return (int) $v;
    if (preg_match('/^-?\d+\.\d+$/', $v)) return (float) $v;
    return $v;
}

function exportValue($v): string {
    if (is_bool($v))   return $v ? 'true' : 'false';
    if (is_int($v))    return (string) $v;
    if (is_float($v))  return (string) $v;
    if (is_null($v))   return 'null';
    if (is_array($v))  return var_export($v, true);
    return var_export((string) $v, true);
}
