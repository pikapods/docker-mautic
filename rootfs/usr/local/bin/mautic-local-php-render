#!/usr/bin/env php
<?php
// mautic-local-php-render: merge env into /data/config/local.php.
//
// Strategy: load all existing keys (preserves anything mautic:install,
// the web installer, or the admin UI wrote), then overwrite the
// operator-managed slots from env, and apply MAUTIC_PARAM_<KEY>
// passthrough on top. Anything the user has set elsewhere survives.
//
// Operator-managed (always overwritten from env): db_driver, db_host,
// db_port, db_name, db_user, db_password, db_table_prefix, site_url.
// secret_key is generated once on first boot and preserved thereafter
// (rotating it invalidates encrypted DB columns and active sessions).
// MAUTIC_PARAM_<KEY> env vars pass through as <key> => <value> after
// lower-snake conversion; sentinel values `unset`, `null`, or empty
// string delete the key. Keys Mautic stores as arrays (see ARRAY_PARAMS)
// accept a friendly comma-separated list and are emitted as a PHP array.
// Keys this script does not own are re-serialized verbatim, so the render is
// verified to round-trip before it replaces the existing file.

if (PHP_SAPI !== 'cli') { fwrite(STDERR, "cli only\n"); exit(2); }

// Mautic parameters whose bundle default is an array (e.g. trusted_proxies,
// trusted_hosts) must be written to local.php as a real PHP array. Mautic
// json_encodes the array when it exports the MAUTIC_<KEY> env var that the
// json: processor decodes (CoreBundle ConfigEnvVars::load), and TrustMiddleware
// reads the raw array straight from local.php for Request::setTrustedProxies()
// — which is typed `array`. A scalar or JSON *string* breaks both paths
// ("array expected, string given" at boot; TypeError on every request).
// Accept either a comma-separated list or a JSON array here; emit a PHP array.
const ARRAY_PARAMS = ['trusted_proxies', 'trusted_hosts'];

$target = $argv[1] ?? '';
if ($target === '') {
    fwrite(STDERR, "usage: mautic-local-php-render <path-to-local.php>\n");
    exit(2);
}

// Load existing file (if any) so every key it defined survives unless
// we explicitly overwrite or delete it below.
$out = [];
if (is_file($target)) {
    $parameters = [];
    // Mautic's local.php only ever defines $parameters; include is safe.
    include $target;
    if (is_array($parameters ?? null)) {
        $out = $parameters;
    }
}

// Ops-managed keys — always overwrite from env.
$out['db_driver']       = 'pdo_mysql';
$out['db_host']         = (string) getenv('MAUTIC_DB_HOST');
$out['db_port']         = (string) (getenv('MAUTIC_DB_PORT') ?: '3306');
$out['db_name']         = (string) getenv('MAUTIC_DB_DATABASE');
$out['db_user']         = (string) getenv('MAUTIC_DB_USER');
$out['db_password']     = (string) getenv('MAUTIC_DB_PASSWORD');
$out['db_table_prefix'] = (string) getenv('MAUTIC_DB_TABLE_PREFIX');
$out['site_url']        = rtrim((string) getenv('MAUTIC_URL'), '/');

// secret_key: generate on first boot only.
if (empty($out['secret_key'])) {
    $out['secret_key'] = bin2hex(random_bytes(32));
}

// MAUTIC_PARAM_<KEY> passthrough. Empty / unset / null deletes.
foreach ($_ENV + getenv() as $name => $value) {
    if (!is_string($name) || strncmp($name, 'MAUTIC_PARAM_', 13) !== 0) {
        continue;
    }
    $raw = substr($name, 13);
    if ($raw === '' || !preg_match('/^[A-Z0-9_]+$/', $raw)) {
        fwrite(STDERR, "[mautic-local-php-render] skip invalid env key: '$name'\n");
        continue;
    }
    $key = strtolower($raw);
    $val = (string) $value;

    if ($val === '' || strcasecmp($val, 'unset') === 0 || strcasecmp($val, 'null') === 0) {
        unset($out[$key]);
        continue;
    }
    $out[$key] = in_array($key, ARRAY_PARAMS, true)
        ? toList($val)
        : coerceScalar($val);
}

// Render as a valid PHP file.
$lines = ["<?php", "// Generated by mautic-local-php-render. Edits will be overwritten on next boot.", "\$parameters = ["];
foreach ($out as $k => $v) {
    $lines[] = sprintf("    %s => %s,", var_export((string) $k, true), exportValue($v));
}
$lines[] = "];";
$lines[] = "";

$tmp = $target . '.tmp';
if (file_put_contents($tmp, implode("\n", $lines)) === false) {
    fwrite(STDERR, "[mautic-local-php-render] failed to write $tmp\n");
    exit(1);
}
// Verify the rendered file reproduces $out exactly before installing it.
// This script re-serializes the whole existing parameter set on every boot,
// so a serializer gap corrupts keys it does not own — persistently, since the
// damage is read back and rewritten next boot. Fail loudly instead: the
// existing local.php stays untouched and the entrypoint dies.
$roundtrip = (static function (string $f) {
    $parameters = null;
    include $f; // own scope; cannot clobber the outer $parameters
    return $parameters;
})($tmp);

if ($roundtrip !== $out) {
    @unlink($tmp);
    fwrite(STDERR, "[mautic-local-php-render] refusing to install $target: rendered file does not round-trip\n");
    exit(1);
}

if (!rename($tmp, $target)) {
    fwrite(STDERR, "[mautic-local-php-render] failed to rename $tmp -> $target\n");
    exit(1);
}
exit(0);

function toList(string $v): array {
    // Accept a value already written as a JSON array, otherwise split a
    // comma-separated list. Either way return a PHP array.
    if (str_starts_with(ltrim($v), '[')) {
        $decoded = json_decode($v, true);
        if (is_array($decoded)) {
            return array_values($decoded);
        }
        // Bracketed but not valid JSON — fall through to CSV parsing.
    }
    return array_values(array_filter(
        array_map('trim', explode(',', $v)),
        static fn (string $s): bool => $s !== ''
    ));
}

function coerceScalar(string $v) {
    // Type-coerce common literals so MAUTIC_PARAM_DB_PORT=3306 lands as int
    // and MAUTIC_PARAM_MAILER_ENCRYPTION_TLS=true lands as bool.
    $lc = strtolower($v);
    if ($lc === 'true')  return true;
    if ($lc === 'false') return false;
    if (preg_match('/^-?\d+$/', $v))      return (int) $v;
    if (preg_match('/^-?\d+\.\d+$/', $v)) return (float) $v;
    return $v;
}

function exportValue($v): string {
    if (is_array($v)) {
        // Compact single-line literal, but only for lists of scalars
        // (trusted_proxies/hosts). Anything else — nested or associative —
        // goes to var_export, which round-trips it faithfully. Casting a
        // nested array to string here would silently write 'Array'.
        if (array_is_list($v) && !array_filter($v, static fn ($i): bool => !is_scalar($i))) {
            $items = array_map(static fn ($i): string => var_export($i, true), $v);
            return '[' . implode(', ', $items) . ']';
        }
        // Not re-indented to match the surrounding block: var_export's own
        // newlines are indistinguishable from newlines inside string values,
        // so reformatting would edit the data.
        return var_export($v, true);
    }
    // var_export renders every scalar (and null) as a faithful PHP literal:
    // true, 80, 1.0, NULL. Stringifying them instead loses the type.
    if ($v === null || is_scalar($v)) {
        return var_export($v, true);
    }
    fwrite(STDERR, "[mautic-local-php-render] non-scalar value coerced to string\n");
    return var_export((string) $v, true);
}
